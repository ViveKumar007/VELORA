# Postgres — local server (no Docker)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/velora

# Payment provider: "stub" (default, no network) or "razorpay"
PAYMENT_PROVIDER=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gemini reads a shopping request into a structured intent. It never sees a
# policy, never picks a product and takes no part in an authorization
# decision. Unset, the agent falls back to the offline rules parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# QuickCommerce: live product and price data for the catalog. Used only by
# `python -m app.sync_catalog`, never from the authorization path.
QUICKCOMMERCE_API_KEY=
QUICKCOMMERCE_LAT=12.9021
QUICKCOMMERCE_LON=77.6639

# How long a PENDING_APPROVAL request stays actionable
APPROVAL_TTL_MINUTES=15

CORS_ORIGINS=http://localhost:5173

# Shared secret for the human-facing API (approve / reject / pay / policies).
# Leave empty ONLY for a localhost demo. Set it for anything reachable.
OPERATOR_TOKEN=

# Allow X-User-Id to impersonate a user. Local multi-user testing only.
DEV_ALLOW_USER_HEADER=false
